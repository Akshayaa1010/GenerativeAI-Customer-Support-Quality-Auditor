# Copy this file to .env and fill in the values.

# Admin login for the dashboard (there is exactly one admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# AI providers
GROQ_API_KEY=
PINECONE_API_KEY=

# Optional overrides
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3
# PINECONE_INDEX_NAME=call-auditor-policy
# PINECONE_EMBED_MODEL=multilingual-e5-large

# Only needed to deploy with scripts/deploy_to_hf_space.py (a Hugging Face "Write" token)
HF_TOKEN=

# Leave empty locally to use SQLite (data/auditor.db). Set to a Postgres URL in production.
DATABASE_URL=
