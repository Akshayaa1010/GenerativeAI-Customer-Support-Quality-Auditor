# ── Version Control ────────────────────────────────────────────────────────
.git
.gitignore
.dockerignore

# ── Python ─────────────────────────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
backend/__pycache__/
frontend/__pycache__/

# ── Environment & Local Config ─────────────────────────────────────────────
# .env is NEVER shipped in the image — all secrets go via Cloud Run env vars
.env
.env.*
*.code-workspace
.vscode/
.idea/

# ── Notebooks ──────────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Local-only data files ──────────────────────────────────────────────────
# SQLite DB and CSV are NOT used on Cloud Run (PostgreSQL is used instead)
data/audit_system.db
data/audit_results.csv
data/users.json
data/uploads/
data/user_data/
data/extracted_email.json

# ── Migration scripts (not needed in production image) ─────────────────────
migrate_to_db.py
inspect_db.py

# ── Logs ───────────────────────────────────────────────────────────────────
*.log

# ── OS files ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
