{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-backend.onrender.com/api/:path*"
    },
    {
      "source": "/register",
      "destination": "https://your-backend.onrender.com/register"
    },
    {
      "source": "/login",
      "destination": "https://your-backend.onrender.com/login"
    },
    {
      "source": "/logout",
      "destination": "https://your-backend.onrender.com/logout"
    }
  ]
}
