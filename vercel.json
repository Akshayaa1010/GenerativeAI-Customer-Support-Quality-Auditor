{
  "version": 2,
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/login.html",
      "dest": "/frontend/templates/login.html"
    },
    {
      "src": "/dashboard.html",
      "dest": "/frontend/templates/dashboard.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://customer-call-auditor--29hk88kg4w4g.code.run/api/$1"
    },
    {
      "src": "/register",
      "dest": "https://customer-call-auditor--29hk88kg4w4g.code.run/register"
    },
    {
      "src": "/logout",
      "dest": "https://customer-call-auditor--29hk88kg4w4g.code.run/logout"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

